#!/bin/sh
#
# Starts Xorg on vt01 (Toyium). Buildroot ships this as part of the Xorg
# server package; kept in-tree so it survives rootfs rebuilds.
#

BIN=/usr/bin/Xorg
PIDFILE=/var/run/xorg.pid

XORG_ARGS=":0.0 -s 0 -noreset -allowMouseOpenFail -sharevts -novtswitch -keeptty"

start() {
	printf "Starting Xorg: "
	start-stop-daemon -S -q -b -m -p $PIDFILE --exec $BIN -- $XORG_ARGS
	[ $? = 0 ] && sleep 3 && echo "OK" || echo "FAIL"
}

stop() {
	printf "Stopping Xorg: "
	start-stop-daemon -K -q -p $PIDFILE
	[ $? = 0 ] && echo "OK" || echo "FAIL"
}

restart() {
	stop
	sleep 2
	start
}

case "$1" in
	start)
		start
	;;
	stop)
		stop
	;;
	restart|reload)
		restart
	;;
	*)
		echo "Usage: $0 {start|stop|restart}"
	exit 1
esac
