#!/bin/sh
# Toyium OS — /init (PID 1)
# Minimal init: mounts virtual FS, sets up TTYs, drops to shell.
# Runs entirely in initramfs (RAM). Non-graphical, 64-bit.

set -eu

# --- helpers ---
msg()  { echo " [toyium] $*"; }
ok()   { echo " [  ok  ] $*"; }
warn() { echo " [ warn ] $*" >&2; }

# mount essential virtual filesystems
msg "Booting Toyium OS v0.1.0 (x86_64) ..."

mount -t proc     none /proc     2>/dev/null && ok "mounted /proc"     || warn "no /proc"
mount -t sysfs    none /sys      2>/dev/null && ok "mounted /sys"      || warn "no /sys"
mount -t devtmpfs none /dev      2>/dev/null && ok "mounted /dev"      || {
    warn "devtmpfs failed, creating static /dev"
    mkdir -p /dev
    mknod -m 622 /dev/console c 5 1 2>/dev/null || true
    mknod -m 666 /dev/null    c 1 3 2>/dev/null || true
    mknod -m 666 /dev/zero    c 1 5 2>/dev/null || true
}
# udev-style
mkdir -p /dev/pts /dev/shm
mount -t devpts   none /dev/pts  2>/dev/null || true
mount -t tmpfs    none /dev/shm  2>/dev/null || true
mount -t tmpfs    none /tmp      2>/dev/null || true
mount -t tmpfs    none /run      2>/dev/null || true

# hostname
if [ -f /etc/hostname ]; then
    hostname -F /etc/hostname 2>/dev/null || true
else
    hostname toyium 2>/dev/null || true
fi
ok "hostname: $(hostname 2>/dev/null || echo toyium)"

# networking — try DHCP if we have ip/udhcpc and an interface
if command -v ip >/dev/null 2>&1; then
    ip link set lo up 2>/dev/null || true
    # bring up eth0 if present (QEMU e1000 / virtio-net)
    if ip link show eth0 >/dev/null 2>&1; then
        ip link set eth0 up 2>/dev/null || true
        if command -v udhcpc >/dev/null 2>&1; then
            msg "udhcpc eth0 (background) ..."
            udhcpc -i eth0 -b -p /run/udhcpc.eth0.pid 2>/dev/null || true
        fi
    fi
fi

# seed /etc/mtab
ln -sf /proc/mounts /etc/mtab 2>/dev/null || true

# clear and banner
clear 2>/dev/null || printf '\033c'

cat /etc/motd 2>/dev/null || cat <<'BANNER'
  _____           _
 |_   _|__  _   _(_)_   _ _ __ ___
   | |/ _ \| | | | | | | | '_ ` _ \
   | | (_) | |_| | | |_| | | | | | |
   |_|\___/ \__, |_|\__,_|_| |_| |_|
            |___/  Toyium OS
BANNER

if [ -f /etc/issue ]; then
    cat /etc/issue
fi

uname -a 2>/dev/null || true
echo ""
# toyium-fetch if available
if command -v toyium-fetch >/dev/null 2>&1; then
    toyium-fetch 2>/dev/null || true
    echo ""
fi

# If /etc/inittab exists and we have init from busybox, use it for getty/TTYs
# Otherwise, just exec a shell on console.
if [ -f /etc/inittab ] && [ -x /sbin/init ]; then
    msg "handing off to /sbin/init (inittab: $(wc -l < /etc/inittab) entries)"
    exec /sbin/init
fi

# --- single-shell mode (default for initramfs) ---
# Try to start a getty on tty1 if available, otherwise plain sh
msg "starting shell (tty: $(tty 2>/dev/null || echo console)) ..."
echo "  Type 'poweroff', 'reboot', or 'halt' to exit QEMU."
echo ""

# environment
export PATH="/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin"
export HOME="/root"
export TERM="linux"
export PS1='\[\e[1;32m\]toyium@toyium\[\e[0m\]:\[\e[1;34m\]\w\[\e[0m\]$ '
cd /root 2>/dev/null || cd /

# If we have setsid + cttyhack (busybox), use them to give shell a proper TTY
if command -v setsid >/dev/null 2>&1 && command -v cttyhack >/dev/null 2>&1; then
    exec setsid cttyhack sh -l
else
    # fallback: plain sh
    # If /dev/console exists, redirect stdio there for QEMU serial
    exec sh -l
fi
